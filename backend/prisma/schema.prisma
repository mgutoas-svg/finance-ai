// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role              String   @default("user") // "admin", "user", "consultant"
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  auditLogs         AuditLog[]

  @@index([tenantId])
  @@index([email])
}

model Tenant {
  id                String   @id @default(cuid())
  name              String
  type              String   @default("personal")
  ownerId           String
  owner             User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  users             User[]
  subscriptions     Subscription[]
  accounts          Account[]
  transactions      Transaction[]
  files             File[]
  auditLogs         AuditLog[]
  auditConsents     AuditConsent[]
  budgets           Budget[]
  goals             Goal[]
  alerts            AlertRule[]
  recurrences       Recurrence[]
  bankAccounts      BankAccount[]
  creditCards       CreditCard[]
  debts             Debt[]
  investments       Investment[]
  familyMembers     FamilyMember[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([ownerId])
}

model Subscription {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId  String?  @unique
  plan              String   @default("free") // "free", "basic", "pro"
  status            String   @default("active") // "active", "canceled", "past_due"
  currentPeriodEnd  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId])
  @@index([stripeCustomerId])
}

model Account {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankCode              String   // "001" = BCB, "260" = Nubank, etc
  bankName              String?
  openFinanceId         String?
  encryptedCredentials  String?  @db.Text // JSON encrypted: {username, password, etc}
  transactions          Transaction[]
  openFinanceTokens     OpenFinanceToken[]
  syncedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([tenantId])
  @@index([openFinanceId])
}

model Transaction {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime
  description       String
  amount            Float
  type              String   // "income" or "expense"
  source            String   @default("manual") // "manual", "pdf", "ofx", "open_finance"
  encryptedData     String?  @db.Text // JSON encrypted: extra sensitive info
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([accountId])
  @@index([date])
}

model File {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String   // "pdf" or "ofx"
  originalName      String
  url               String
  parsedData        String?  @db.Text // JSON: metadata from parser
  transactionCount  Int      @default(0)
  uploadedAt        DateTime @default(now())

  @@index([tenantId])
}

model AuditLog {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action            String   // "user.login", "transaction.create", "data.access", etc
  description       String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AuditConsent {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type              String   // "lgpd" or "open_finance"
  accepted          Boolean  @default(true)
  acceptedAt        DateTime @default(now())
  expiresAt         DateTime?

  @@index([tenantId])
  @@index([type])
}

model OpenFinanceToken {
  id                      String   @id @default(cuid())
  accountId               String
  account                 Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  encryptedAccessToken    String   @db.Text
  encryptedRefreshToken   String?  @db.Text
  expiresAt               DateTime
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([accountId])
  @@unique([accountId])
}

// SPRINT 1: Budgets
model Budget {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  String
  limit     Float
  period    String   @default("monthly")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@unique([tenantId, category, period])
}

// SPRINT 2: Goals
model Goal {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  targetAmount    Float
  currentAmount   Float    @default(0)
  deadline        DateTime
  category        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId])
  @@index([deadline])
}

// SPRINT 3: Alerts
model AlertRule {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String   // "budget_exceeded", "goal_deadline", "account_low"
  threshold Float?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// SPRINT 4: Recurrences
model Recurrence {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionId    String
  frequency        String   // "daily", "weekly", "monthly", "annual"
  endDate          DateTime?
  nextOccurrence   DateTime
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([nextOccurrence])
}

// SPRINT 5-6: Bank Accounts & Credit Cards
model BankAccount {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankCode         String
  bankName         String?
  accountNumber    String
  balance          Float
  balanceUpdatedAt DateTime?
  createdAt        DateTime @default(now())

  @@index([tenantId])
}

model CreditCard {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankCode    String
  cardName    String
  limit       Float
  usedAmount  Float    @default(0)
  dueDay      Int
  brand       String   // "Visa", "Mastercard"
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

// SPRINT 7: Debts
model Debt {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditorName     String
  totalAmount      Float
  remainingAmount  Float
  interestRate     Float    @default(0)
  monthlyPayment   Float
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([endDate])
}

// SPRINT 9: Investments
model Investment {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            String   // "stock", "fund", "crypto", "treasury"
  name            String
  ticker          String?
  quantity        Float
  averageCost     Float
  currentPrice    Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

// SPRINT 11: Family Members
model FamilyMember {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String   @default("viewer") // "admin", "editor", "viewer"
  inviteStatus String   @default("pending") // "pending", "accepted"
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}
